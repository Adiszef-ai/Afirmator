# Example secrets configuration for Streamlit
# Copy this file to secrets.toml and fill in your actual API keys

# OpenAI API configuration
[openai]
api_key = "sk-your-openai-api-key-here"

# Groq API configuration (optional)
[groq] 
api_key = "gsk_your-groq-api-key-here"

# Instructions:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit secrets.toml to version control!